// This blog's identity. Everything else in lib/ and assets/theme.css is shared with ~/code/claude_blogs.
#let site-title = "Underclocked Thoughts"
#let site-tagline = "A slow atom drifting through computational waters."
#let site-author = "Adi Shourya"
#let nav-links = (
  ("index.html", "Articles"),
  ("about.html", "About"),
)

// Fonts for this blog: Martian Mono only, loaded from ExtraLight (200) up so in-between weights like 250 work, no italics.
// Which weights are used is set in assets/art.css (regular = 250, bold = 400 Regular).
#let site-fonts = "https://fonts.googleapis.com/css2?family=Martian+Mono:wdth,wght@75..112.5,200..800&display=swap"
